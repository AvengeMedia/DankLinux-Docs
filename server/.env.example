PORT=8337
ENVIRONMENT=development
GITHUB_TOKEN=
KLIPY_API_KEY=
POEDITOR_CALLBACK_SECRET=
GITHUB_WEBHOOK_SECRET=
# Moderation auth: prefer a GitHub App (actions attributed to the App bot).
# Falls back to GITHUB_MOD_TOKEN (a PAT) only if the App vars are unset.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_MOD_TOKEN=
PLUGIN_MOD_ORG=AvengeMedia
PLUGIN_MOD_TEAM=plugin-moderators
# Owners bypass all moderation restrictions (incl. verifying their own plugin).
PLUGIN_OWNERS_TEAM=owners
DISCORD_WEBHOOK_URL=
UPLOAD_TOKEN=
UPLOAD_DIR=/data/uploads
CACHE_DIR=/data/cache
PUBLIC_BASE_URL=https://api.danklinux.com
# Fedora messaging consumer: fires repository_dispatch (fedora-qt-update) at
# QT_REBUILD_REPO when a watched qt6 update reaches stable. Uses the GitHub App
# above (needs Contents: write on that repo) or GITHUB_MOD_TOKEN. TLS dir must
# hold cacert.pem, fedora-cert.pem and fedora-key.pem, Fedora's public read-only
# pair from https://github.com/fedora-infra/fedora-messaging/tree/stable/configs
# (k8s: secret fedora-messaging mounted at /etc/fedora-messaging).
FEDORA_MESSAGING_ENABLED=false
FEDORA_MESSAGING_URL=amqps://fedora:@rabbitmq.fedoraproject.org/%2Fpublic_pubsub
FEDORA_MESSAGING_TLS_DIR=
QT_REBUILD_REPO=AvengeMedia/danklinux
QT_REBUILD_PACKAGES=qt6-qtbase,qt6-qtdeclarative,qt6-qtwayland
